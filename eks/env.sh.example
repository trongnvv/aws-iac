# Copy to env.sh (gitignored), fill from layer0 outputs, then `source env.sh`
# before running helmfile in layer1/layer2.
#   cd layer0-provisioning/01-eks && tofu output -raw cluster_name
export CLUSTER_NAME=eks-dev
export AWS_REGION=ap-southeast-1
export VPC_ID=vpc-xxxxxxxx                        # 00-network: tofu output -raw vpc_id
export KARPENTER_QUEUE_NAME=Karpenter-eks-dev     # 03-karpenter-infra: karpenter_queue_name
export KARPENTER_NODE_ROLE=Karpenter-eks-dev      # 03-karpenter-infra: karpenter_node_iam_role_name
export DOMAIN_FILTER=example.com                  # external-dns / cert-manager
export ACME_EMAIL=you@example.com                 # cert-manager Let's Encrypt
export BACKUP_BUCKET=eks-velero-backups           # 08-backup-aws: velero_bucket (when enable_backup=true)
export DNS_CLUSTER_IP=10.100.0.10                 # 09-dns-scale: kube-dns ClusterIP (kubectl -n kube-system get svc kube-dns)
