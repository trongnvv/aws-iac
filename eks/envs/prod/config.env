# Env "prod" — helmfile-only settings. Layer0 values live in the per-layer roots
# (envs/prod/*/main.tf), not here. Sourced by scripts/deploy.sh.

export ACME_EMAIL=you@example.com
export DOMAIN_FILTER=example.com

# helmfile add-on lists to apply for this env (large preset)
L1="00-karpenter 01-metrics-server 02-aws-load-balancer-controller 03-external-dns 04-cert-manager 05-external-secrets 06-kyverno 08-keda 09-dns-scale"
L2="00-argocd 01-observability 02-velero 03-argo-rollouts 04-kubecost 05-api-gateway 06-service-mesh 07-falco"
NETPOL=1
