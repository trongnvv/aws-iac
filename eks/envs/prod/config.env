# Env "prod" — large preset (regulated). Sourced by scripts/deploy.sh.

export TF_VAR_env=prod
export TF_VAR_cluster_name=eks-prod

# network — distinct CIDRs from dev (10.0/16) so the VPCs can peer/TGW without overlap
export TF_VAR_vpc_cidr=10.1.0.0/16
export TF_VAR_secondary_cidr_block=100.65.0.0/16
export TF_VAR_nat_per_az=true
export TF_VAR_enable_secondary_cidr=true
export TF_VAR_enable_network_firewall=true

# cluster
export TF_VAR_enable_control_plane_logging=true
export TF_VAR_enable_secret_encryption=true
export TF_VAR_cluster_endpoint_public_access=false
export TF_VAR_enable_pod_eni=true
export TF_VAR_enable_network_policy=true
export TF_VAR_enable_efs_csi=true

# security baseline — ACCOUNT-LEVEL singletons: GuardDuty detector, Security Hub,
# and the Config recorder are one-per-account/region. Enable them in exactly ONE
# env per account; this env (prod) owns them. Other envs keep them off.
export TF_VAR_enable_guardduty=true
export TF_VAR_enable_cloudtrail=true
export TF_VAR_enable_config=true
export TF_VAR_enable_securityhub=true

# registry / observability / backup / edge
export TF_VAR_enable_enhanced_scan=true
export TF_VAR_enable_amp=true
export TF_VAR_enable_backup=true
export TF_VAR_enable_waf=true

# app-specific (helmfile)
export ACME_EMAIL=you@example.com
export DOMAIN_FILTER=example.com

# helmfile add-on lists to apply for this env
L1="00-karpenter 01-metrics-server 02-aws-load-balancer-controller 03-external-dns 04-cert-manager 05-external-secrets 06-kyverno 08-keda 09-dns-scale"
L2="00-argocd 01-observability 02-velero 03-argo-rollouts 04-kubecost 05-api-gateway 06-service-mesh 07-falco"
NETPOL=1
