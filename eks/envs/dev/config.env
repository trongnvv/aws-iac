# Env "dev" — small preset. Sourced by scripts/deploy.sh.
# tofu vars via TF_VAR_* (undeclared ones are ignored per folder, no warnings).

export TF_VAR_env=dev
export TF_VAR_cluster_name=eks-dev
# all paid toggles left at their defaults (off) → cost-minimal.
# Account-level security (GuardDuty/Security Hub/Config) stays OFF here — those are
# one-per-account singletons owned by the prod env. Uses the default VPC CIDR (10.0/16).

# app-specific (helmfile)
export ACME_EMAIL=you@example.com

# helmfile add-on lists to apply for this env
L1="00-karpenter 01-metrics-server 02-aws-load-balancer-controller 04-cert-manager 05-external-secrets"
L2="00-argocd 01-observability"
NETPOL=0
