# Env "dev" — helmfile-only settings. Layer0 values live in the per-layer roots
# (envs/dev/*/main.tf), not here. Sourced by scripts/deploy.sh.

export ACME_EMAIL=you@example.com

# helmfile add-on lists to apply for this env (small preset)
L1="00-karpenter 01-metrics-server 02-aws-load-balancer-controller 04-cert-manager 05-external-secrets"
L2="00-argocd 01-observability"
NETPOL=0
