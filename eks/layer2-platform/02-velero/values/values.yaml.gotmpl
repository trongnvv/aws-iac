serviceAccount:
  server:
    name: velero
credentials:
  useSecret: false
initContainers:
  - name: velero-plugin-for-aws
    image: velero/velero-plugin-for-aws:v1.11.0
    volumeMounts:
      - mountPath: /target
        name: plugins
configuration:
  backupStorageLocation:
    - name: aws
      provider: aws
      bucket: {{ requiredEnv "BACKUP_BUCKET" | quote }}
      config:
        region: {{ requiredEnv "AWS_REGION" | quote }}
  volumeSnapshotLocation:
    - name: aws
      provider: aws
      config:
        region: {{ requiredEnv "AWS_REGION" | quote }}
